# Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sampleapp?schema=public

# JWT
JWT_SECRET=supersecretjwtkeywithatleast32chars123456
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:8080"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="100"

# Disposable Email Protection
DISPOSABLE_EMAIL_BLOCKLIST_PATH="./config/disposable-domains.txt"
DISPOSABLE_EMAIL_ALLOWLIST_PATH="./config/allowed-domains.txt"

# Password Policy
PASSWORD_MIN_LENGTH="8"
PASSWORD_REQUIRE_UPPERCASE="true"
PASSWORD_REQUIRE_LOWERCASE="true"
PASSWORD_REQUIRE_NUMBER="true"
PASSWORD_REQUIRE_SPECIAL="true"

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/callback/google"

# Email Service (for verification / reset / magic link)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
FROM_EMAIL="noreply@example.com"
